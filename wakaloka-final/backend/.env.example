# Salin menjadi .env lalu isi nilainya. Jangan commit .env ke GitHub.
PORT=3000
# Rahasia penanda token login. Isi teks acak yang panjang.
JWT_SECRET=
# Kode yang diberikan pengelola loket kepada calon petugas saat mendaftar.
# Kosong = pendaftaran sebagai petugas dinonaktifkan.
PETUGAS_CODE=
# Alamat frontend yang boleh memanggil API (pisahkan dengan koma).
FRONTEND_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
DB_FILE=./wakaloka.db
