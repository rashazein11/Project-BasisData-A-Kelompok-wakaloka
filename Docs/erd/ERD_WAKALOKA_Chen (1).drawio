html=1;strokeColor=#7EA6E0;strokeWidth=1;" edge="1" parent="1" source="TIKET.status_tiket" target="TIKET"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="a30" value="" style="endArrow=none;html=1;strokeColor=#7EA6E0;strokeWidth=1;" edge="1" parent="1" source="PRODUK_UMKM.id_produk" target="PRODUK_UMKM"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="a31" value="" style="endArrow=none;html=1;strokeColor=#7EA6E0;strokeWidth=1;" edge="1" parent="1" source="PRODUK_UMKM.id_wisata" target="PRODUK_UMKM"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="a32" value="" style="endArrow=none;html=1;strokeColor=#7EA6E0;strokeWidth=1;" edge="1" parent="1" source="PRODUK_UMKM.nama_produk" target="PRODUK_UMKM"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="a33" value="" style="endArrow=none;html=1;strokeColor=#7EA6E0;strokeWidth=1;" edge="1" parent="1" source="PRODUK_UMKM.harga" target="PRODUK_UMKM"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="a34" value="" style="endArrow=none;html=1;strokeColor=#7EA6E0;strokeWidth=1;" edge="1" parent="1" source="PRODUK_UMKM.foto" target="PRODUK_UMKM"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="a35" value="" style="endArrow=none;html=1;strokeColor=#7EA6E0;strokeWidth=1;" edge="1" parent="1" source="Memuat.jumlah" target="Memuat"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="legend" value="&lt;b&gt;Keterangan&lt;/b&gt;&lt;br&gt;Entitas = persegi panjang. Relasi = belah ketupat.&lt;br&gt;Atribut biasa = oval oranye.&lt;br&gt;Primary Key = oval biru, bergaris bawah.&lt;br&gt;Foreign Key = oval tosca.&lt;br&gt;Kardinalitas: 1 = satu, M / N = banyak.&lt;br&gt;Garis tipis biru = penghubung atribut.&lt;br&gt;&lt;br&gt;Relasi M:N (Memuat) dipecah menjadi tabel DETAIL_PRODUK_PESANAN yang berisi 2 FK, jumlah, dan harga_satuan. Atribut role (wisatawan / petugas) pada PENGGUNA membedakan Wisatawan dan Petugas Loket. harga_tiket dan harga_satuan adalah salinan harga saat pesan (snapshot); total dan tgl_berlaku disimpan agar riwayat dan validasi tidak berubah jika harga diubah. Pada relasi 1:M, FK berada di entitas sisi M." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#F5F5F5;strokeColor=#999999;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="760" width="380" height="230" as="geometry"/></mxCell><mxCell id="title" value="ERD WakaLoka (Notasi Chen)" style="text;html=1;align=left;verticalAlign=middle;fontSize=18;fontStyle=1;fontColor=#1F3864;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="360" height="30" as="geometry"/></mxCell><mxCell id="PENGGUNA.role" value="role" style="ellipse;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#F08A24;fontSize=11;" vertex="1" parent="1"><mxGeometry x="330" y="424" width="112" height="36" as="geometry"/></mxCell><mxCell id="n1" value="" style="endArrow=none;html=1;strokeColor=#7EA6E0;strokeWidth=1;" edge="1" parent="1" source="PENGGUNA.role" target="PENGGUNA"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="PEMESANAN.harga_tiket" value="harga_tiket" style="ellipse;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#F08A24;fontSize=11;" vertex="1" parent="1"><mxGeometry x="505" y="590" width="112" height="36" as="geometry"/></mxCell><mxCell id="n2" value="" style="endArrow=none;html=1;strokeColor=#7EA6E0;strokeWidth=1;" edge="1" parent="1" source="PEMESANAN.harga_tiket" target="PEMESANAN"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="PEMESANAN.total" value="total" style="ellipse;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#F08A24;fontSize=11;" vertex="1" parent="1"><mxGeometry x="892" y="590" width="112" height="36" as="geometry"/></mxCell><mxCell id="n3" value="" style="endArrow=none;html=1;strokeColor=#7EA6E0;strokeWidth=1;" edge="1" parent="1" source="PEMESANAN.total" target="PEMESANAN"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="TIKET.tgl_berlaku" value="tgl_berlaku" style="ellipse;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#F08A24;fontSize=11;" vertex="1" parent="1"><mxGeometry x="874" y="40" width="112" height="36" as="geometry"/></mxCell><mxCell id="n4" value="" style="endArrow=none;html=1;strokeColor=#7EA6E0;strokeWidth=1;" edge="1" parent="1" source="TIKET.tgl_berlaku" target="TIKET"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="Memuat.harga_satuan" value="harga_satuan" style="ellipse;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#F08A24;fontSize=11;" vertex="1" parent="1"><mxGeometry x="824" y="1052" width="112" height="36" as="geometry"/></mxCell><mxCell id="n5" value="" style="endArrow=none;html=1;strokeColor=#7EA6E0;strokeWidth=1;" edge="1" parent="1" source="Memuat.harga_satuan" target="Memuat"><mxGeometry relative="1" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>